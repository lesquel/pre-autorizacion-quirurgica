# Build / cache
.venv
.mypy_cache
.pytest_cache
.ruff_cache
__pycache__
*.pyc
*.pyo
*.pyd
.coverage
htmlcov
.cache

# Secrets — NUNCA en la imagen. Las env vars se inyectan en runtime por
# el platform (Cloud Run secrets, Fly secrets, Railway variables).
.env
.env.*
!.env.example

# Runtime artefacts (storage local del operador, no debe ir a la imagen)
var/

# VCS / IDE
.git
.gitignore
.github
.vscode
.idea
.editorconfig

# Tests (no se necesitan en runtime)
tests/
docs/
# README.md SÍ va al context: pyproject.toml declara `readme = "README.md"`
# y uv lo lee durante `uv sync` para construir el package metadata.
# Excluirlo rompe el build con "failed to open file /app/README.md".
# Otros .md sí los podemos excluir (CHANGELOG.md, NOTES.md, etc).

# Otros
.DS_Store
Thumbs.db
